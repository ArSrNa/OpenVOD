# =============================================================================
# OpenVOD 播放演示 App（apps/player）环境变量模板（spec.md §11.2）
#
# 播放端 Web 参考实现：免登录，服务端用「预览播放账号」自动向分发端换 JWT
# （凭据不下发浏览器）；浏览器只与 player 同源通信——API / 清单 / 密钥 / 字幕经 /api/delivery 代理，
# 分片仍由浏览器直连对象存储（全程 URL 签名）。
#
# 三端（admin / delivery / worker）共享仓库根 .env；player 的键已在根 .env.example
# 登记。本文件用于单独部署 / 运行 player 时复制为 .env（bun run --cwd apps/player dev）。
# =============================================================================

# 端口（next dev / next start 用；scripts/dev.ts 读取后经 env 传给 Next）
PLAYER_PORT="3100"

# 服务端调分发端的地址（login / media / play / 清单 / 密钥 / 字幕；spec.md §11.9 同源代理，不经过浏览器）
DELIVERY_BASE_URL="http://127.0.0.1:9000"

# 预览播放账号（必填；分发端 login 用，播放解密链路本身不需要账号口令）
# 创建 / 重置：bun apps/admin/scripts/bootstrap-playback.ts <用户名> <口令≥8位>
# 缺省回退管理端预览账号 DELIVERY_PREVIEW_USERNAME / DELIVERY_PREVIEW_PASSWORD
PLAYER_PREVIEW_USERNAME=""
PLAYER_PREVIEW_PASSWORD=""
