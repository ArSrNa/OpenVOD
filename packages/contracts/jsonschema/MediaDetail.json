{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "poster_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "custom": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string"
    },
    "probe": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "video_codec": {
              "type": [
                "string",
                "null"
              ]
            },
            "audio_codec": {
              "type": [
                "string",
                "null"
              ]
            },
            "bitrate_bps": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "width",
            "height",
            "video_codec",
            "audio_codec",
            "bitrate_bps"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "lang",
          "label",
          "is_default"
        ]
      }
    },
    "playable": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title",
    "poster_url",
    "duration_ms",
    "custom",
    "status",
    "probe",
    "subtitles",
    "playable"
  ],
  "$id": "MediaDetail.json",
  "title": "MediaDetail"
}
