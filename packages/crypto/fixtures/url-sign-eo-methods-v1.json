  "notes": "timestampSec = 传给 URL 组装函数的时间戳（秒）：B/C/D 为签发时刻、V 为过期时刻；base = URL host（hash 与 host 无关）",
  "methods": {
    "b": {
      "spec": "URL = {base}/{timestamp}/{md5hash}/{path}；timestamp = UTC+8 \"YYYYMMDDHHMM\"（分钟精度）；md5hash = MD5(key + timestamp + path)",
      "vectors": [
        {
          "name": "eo-official-example",
