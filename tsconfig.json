{
  // Bun 只按文件名 tsconfig.json 查找路径别名：根目录脚本与没有自身 tsconfig 的包
  // （packages/{contracts,crypto,db}）会回落到本文件解析 @root/*；已有自身 tsconfig 的
  // 包（apps/worker、packages/player-sdk）走各自的 extends，不依赖本文件。
  // 别名真源在 tsconfig.base.json，勿在此重复声明 paths。
  "extends": "./tsconfig.base.json",
  "include": [
    "scripts/**/*.ts",
    // 这三个包没有自己的 tsconfig，其构建脚本由根 package.json 用 bun 直接运行
    // （task contracts / vectors / db:parity），须纳入本工程才会被 tsc 检查。
    "packages/contracts/scripts/**/*.ts",
    "packages/crypto/scripts/**/*.ts",
    "packages/db/scripts/**/*.ts"
  ],
  // 显式排除依赖与构建产物；.run 内含 task edgeone:prepare 生成的源码副本，
  // 一旦 include 扩大可避免同一份代码被重复检查。
  "exclude": ["node_modules", "dist", ".next", ".run"]
}
